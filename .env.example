# ============================================
# Arionear Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081
# Production example:
# APP_ENV=production
# CORS_ORIGINS=https://app.your-domain.com

# ---- Frontend (build-time — Vite) ----
# Set when building: VITE_API_URL=https://api.your-domain.com/api/v1 npm run build
# VITE_API_URL=http://localhost:8000/api/v1

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=Arionear-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Vite editor uses VITE_API_URL (see section above)

# ---- OpenRouter (optional — use one key for many models during dev) ----
# Set LLM_PROVIDER=openrouter to make OpenRouter the backend default.
# You can also switch provider in the editor chat dock without changing .env.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_DEFAULT_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=Arionear Academic Editor
