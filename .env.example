# ============================================
# Arionear Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!
#
# Generate JWT secret: openssl rand -hex 32

# ---- LLM Configuration ----
LLM_PROVIDER=openrouter
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TEMPERATURE=0.3

# OpenRouter (default)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_LOGIC_AUDIT_QUICK_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:8080
OPENROUTER_APP_NAME=Arionear Academic Editor

# Other providers (uncomment the one you use)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_DEFAULT_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
# GOOGLE_API_KEY=
# Z.AI (set LLM_PROVIDER=zai)
# ZAI_API_KEY=your-zai-api-key-here
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_DEFAULT_MODEL=glm-4.7-flash

# ---- Database (Prisma Postgres only — no SQLite) ----
# FastAPI/SQLAlchemy: direct TCP (Prisma Console → Connect → Direct)
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Prisma CLI / Accelerate
DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_KEY

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
LOG_LEVEL=INFO

# ---- Auth (JWT) ----
AUTH_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
AUTH_TOKEN_EXPIRE_HOURS=72
AUTH_TOKEN_REMEMBER_DAYS=30
AUTH_RESET_EXPIRE_MINUTES=30
AUTH_SIGNUP_CODE_EXPIRE_MINUTES=15
AUTH_SIGNUP_MAX_ATTEMPTS=5

# ---- CORS & URLs ----
# FRONTEND_BASE_URL: used in emails/QR when Host header is unavailable.
# For phone QR testing on LAN, open the app via http://<your-lan-ip>:8080 so checkout QR uses that host.
# Production: include your deployed frontend URL (deploy script sets this on Cloud Run).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:8080
BACKEND_BASE_URL=http://127.0.0.1:8000
# Production example:
# FRONTEND_BASE_URL=https://arionear.id.vn
# BACKEND_BASE_URL=https://api.arionear.id.vn
# CORS_ORIGINS=https://arionear.id.vn,https://api.arionear.id.vn
# Local dev only. Production Cloud Run sets this to https://api.arionear.id.vn/api/v1/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# ---- SSO (Google Sign-In) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- SMTP (signup verification & password reset) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your@gmail.com
SMTP_USE_TLS=true
# Use SMTP_USE_SSL=true with port 465 (e.g. some providers); do not combine with STARTTLS on 587
SMTP_USE_SSL=false
AUTH_SIGNUP_RESEND_COOLDOWN_SECONDS=60

# ---- God Admin (sole superuser — provisioned on startup) ----
ADMIN_GOD_EMAIL=admin@arionear.local
ADMIN_GOD_PASSWORD=change-me-strong-password
ADMIN_GOD_NAME=Platform God Admin

# ---- Academic integrity / guardrails ----
INTEGRITY_STRICTNESS=standard
SEMANTIC_SIMILARITY_THRESHOLD=0.0
MAX_STYLE_RETRIES=2

# ---- External APIs ----
# Optional — citation verification via Semantic Scholar
# SEMANTIC_SCHOLAR_API_KEY=

# ---- LangSmith (AI tracing — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=Arionear-agent
LANGCHAIN_TRACING_V2=true

# ---- Inngest (chat pipeline observability — optional) ----
# INNGEST_DEV=1
# INNGEST_APP_ID=ario-academic-editor
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (Vite) ----
# Dev: proxy /api/v1 → backend (default port 8000)
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
# Production build: absolute API base URL
# VITE_API_URL=https://api.your-domain.com/api/v1

# Gate 3 evaluation (optional — for eval/scripts/run_gate3_eval.py)
# GATE3_API_URL=https://your-api.run.app
# GATE3_FRONTEND_URL=https://your-frontend.run.app
