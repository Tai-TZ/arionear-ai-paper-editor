# ============================================
# Arionear Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Arionear Academic Editor

OPENROUTER_APP_NAME=Arionear Academic Editor

# ---- NVIDIA NIM (MiniMax M3 via build.nvidia.com) ----
# Get NVAPI key: https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_DEFAULT_MODEL=minimaxai/minimax-m3
# LLM_PROVIDER=nvidia

# Or use other providers:
# OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Z.AI (optional — set LLM_PROVIDER=zai to use)
# ZAI_API_KEY=your-zai-api-key-here
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_DEFAULT_MODEL=glm-4.7-flash

# ---- Database (Prisma Postgres only — no SQLite) ----
# FastAPI/SQLAlchemy: direct TCP connection (copy from Prisma Console → Connect → Direct)
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_KEY

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=Arionear-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log

# ---- SSO Configuration SignIn ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ---- CORS Configuration ----
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:8080
BACKEND_BASE_URL=http://127.0.0.1:8000
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# ---- SMTP Configuration for Email Verification ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your@gmail.com
SMTP_USE_TLS=true
AUTH_SIGNUP_CODE_EXPIRE_MINUTES=15

# ---- God Admin (sole superuser — provisioned on startup) ----
ADMIN_GOD_EMAIL=admin@arionear.local
ADMIN_GOD_PASSWORD=change-me-strong-password
ADMIN_GOD_NAME=Platform God Admin
