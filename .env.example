# ============================================
# Arionear Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database (Prisma schema + SQLAlchemy runtime) ----
# Prisma Postgres — cần 2 URL từ console.prisma.io → project → Connect:
#
# DATABASE_URL       = Prisma Accelerate (prisma+postgres://...) — cho npm run db:migrate
# DIRECT_DATABASE_URL = Direct TCP (postgresql://...) — cho FastAPI/SQLAlchemy
#
# DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# Option B — Local PostgreSQL (Docker):
# DATABASE_URL=postgresql://arionear:arionear@localhost:5432/arionear
#
# Option C — SQLite quick dev (no Prisma migrate; tables auto-created):
# DATABASE_URL=sqlite:///./data/app.db
DATABASE_URL=postgresql://user:password@localhost:5432/arionear

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=Arionear-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- OpenRouter (optional — use one key for many models during dev) ----
# Set LLM_PROVIDER=openrouter to make OpenRouter the backend default.
# You can also switch provider in the editor chat dock without changing .env.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_DEFAULT_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_APP_NAME=Arionear Academic Editor
