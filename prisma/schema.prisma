// Arionear — Scientific Paper Assistant
// Source of truth for PostgreSQL schema.
// Python backend connects via SQLAlchemy using the same DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  RESEARCHER
  ADMIN
}

enum PaperStatus {
  DRAFT
  IN_REVIEW
  SUBMITTED
  PUBLISHED
  ARCHIVED
}

enum SectionType {
  ABSTRACT
  INTRODUCTION
  METHODS
  RESULTS
  DISCUSSION
  CONCLUSION
  REFERENCES
  CUSTOM
  FULL_DOCUMENT
}

enum TaskType {
  STYLE
  STRUCTURE
  LOGIC
  CITATION
  TEMPLATE
  CHAT
}

enum SuggestionType {
  STYLE
  GRAMMAR
  STRUCTURE
  CITATION
  LOGIC
  GENERAL
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
  MODIFIED
}

enum CitationType {
  JOURNAL
  CONFERENCE
  BOOK
  PREPRINT
  WEB
  OTHER
}

enum CitationVerificationStatus {
  VERIFIED
  PARTIAL
  UNVERIFIED
  NOT_FOUND
  ERROR
}

enum ReviewSeverity {
  CRITICAL
  MAJOR
  MINOR
  SUGGESTION
}

enum ReviewCategory {
  METHODOLOGY
  CLARITY
  NOVELTY
  CITATION
  LANGUAGE
  OTHER
}

enum ResponseStatus {
  DRAFT
  ACCEPTED
  REJECTED
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  ACCEPT_SUGGESTION
  REJECT_SUGGESTION
  VERIFY_CITATION
  CHAT
}

// ─── Core tables (ERD) ───────────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  fullName       String    @map("full_name")
  institution    String?
  nativeLanguage String?   @map("native_language")
  researchField  String?   @map("research_field")
  profileSettings Json     @default("{}") @map("profile_settings")
  role           UserRole  @default(RESEARCHER)
  passwordHash   String?   @map("password_hash")
  googleSub      String?   @unique @map("google_sub")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastActiveAt   DateTime? @map("last_active_at")

  papers              Paper[]
  aiSessions          AiSession[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model SignupVerification {
  id           String    @id @default(uuid()) @db.Uuid
  email        String
  fullName     String    @map("full_name")
  institution  String?
  passwordHash String    @map("password_hash")
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("signup_verifications")
}

model Paper {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  title         String      @default("Untitled")
  status        PaperStatus @default(DRAFT)
  targetJournal String?     @map("target_journal")
  citationStyle String?     @map("citation_style")
  languageLevel String?     @map("language_level")
  /// Full LaTeX source — keeps compatibility with current editor (monolithic blob).
  rawLatex      String      @default("") @map("raw_latex") @db.Text
  /// Flexible metadata (journal template, LLM prefs, etc.)
  metadata      Json        @default("{}")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  sections          PaperSection[]
  aiSessions        AiSession[]
  citations         Citation[]
  reviewerComments  ReviewerComment[]
  auditLogs         AuditLog[]

  @@index([userId])
  @@map("papers")
}

model PaperSection {
  id              String      @id @default(uuid()) @db.Uuid
  paperId         String      @map("paper_id") @db.Uuid
  sectionType     SectionType @map("section_type")
  orderIndex      Int         @map("order_index")
  originalContent String      @default("") @map("original_content") @db.Text
  currentContent  String      @default("") @map("current_content") @db.Text
  wordCount       Int         @default(0) @map("word_count")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  paper          Paper           @relation(fields: [paperId], references: [id], onDelete: Cascade)
  aiSessions     AiSession[]
  suggestions    Suggestion[]
  citationUsages CitationUsage[]

  @@index([paperId])
  @@map("paper_sections")
}

model AiSession {
  id              String    @id @default(uuid()) @db.Uuid
  paperId         String    @map("paper_id") @db.Uuid
  sectionId       String?   @map("section_id") @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  taskType        TaskType  @map("task_type")
  userInput       String    @default("") @map("user_input") @db.Text
  aiOutput        String    @default("") @map("ai_output") @db.Text
  metadata        Json      @default("{}")
  tokensUsed      Int       @default(0) @map("tokens_used")
  confidenceScore Float?    @map("confidence_score")
  createdAt       DateTime  @default(now()) @map("created_at")

  paper               Paper                @relation(fields: [paperId], references: [id], onDelete: Cascade)
  section             PaperSection?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  suggestions         Suggestion[]
  responseSuggestions ResponseSuggestion[]

  @@index([paperId])
  @@index([sectionId])
  @@map("ai_sessions")
}

model Suggestion {
  id              String           @id @default(uuid()) @db.Uuid
  sessionId       String           @map("session_id") @db.Uuid
  sectionId       String?          @map("section_id") @db.Uuid
  suggestionType  SuggestionType   @default(STYLE) @map("suggestion_type")
  originalText    String           @map("original_text") @db.Text
  suggestedText   String           @map("suggested_text") @db.Text
  sectionLabel    String?          @map("section_label")
  explanation     String?          @db.Text
  diff            String?          @db.Text
  status          SuggestionStatus @default(PENDING)
  createdAt       DateTime         @default(now()) @map("created_at")
  resolvedAt      DateTime?        @map("resolved_at")

  aiSession AiSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  section   PaperSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@map("suggestions")
}

model Citation {
  id                 String                     @id @default(uuid()) @db.Uuid
  paperId            String                     @map("paper_id") @db.Uuid
  citationKey        String                     @map("citation_key")
  citationType       CitationType               @default(OTHER) @map("citation_type")
  authors            String?
  title              String?
  journal            String?
  year               Int?
  doi                String?
  eprint             String?
  rawText            String?                    @map("raw_text") @db.Text
  formattedStyles    Json                       @default("{}") @map("formatted_styles")
  verificationStatus CitationVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verificationMessage String?                   @map("verification_message") @db.Text
  verificationLayers Json                       @default("[]") @map("verification_layers")
  createdAt          DateTime                   @default(now()) @map("created_at")

  paper  Paper           @relation(fields: [paperId], references: [id], onDelete: Cascade)
  usages CitationUsage[]

  @@unique([paperId, citationKey])
  @@index([paperId])
  @@map("citations")
}

model CitationUsage {
  id              String @id @default(uuid()) @db.Uuid
  citationId      String @map("citation_id") @db.Uuid
  sectionId       String @map("section_id") @db.Uuid
  positionStart   Int    @map("position_start")
  positionEnd     Int    @map("position_end")
  contextSnippet  String @map("context_snippet") @db.Text

  citation Citation     @relation(fields: [citationId], references: [id], onDelete: Cascade)
  section  PaperSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([citationId])
  @@index([sectionId])
  @@map("citation_usages")
}

model ReviewerComment {
  id            String         @id @default(uuid()) @db.Uuid
  paperId       String         @map("paper_id") @db.Uuid
  reviewerLabel String         @map("reviewer_label")
  commentText   String         @map("comment_text") @db.Text
  severity      ReviewSeverity
  category      ReviewCategory
  createdAt     DateTime       @default(now()) @map("created_at")

  paper               Paper                @relation(fields: [paperId], references: [id], onDelete: Cascade)
  responseSuggestions ResponseSuggestion[]

  @@index([paperId])
  @@map("reviewer_comments")
}

model ResponseSuggestion {
  id                 String         @id @default(uuid()) @db.Uuid
  commentId          String         @map("comment_id") @db.Uuid
  sessionId          String         @map("session_id") @db.Uuid
  suggestedResponse  String         @map("suggested_response") @db.Text
  revisionNote       String?        @map("revision_note") @db.Text
  status             ResponseStatus @default(DRAFT)
  createdAt          DateTime       @default(now()) @map("created_at")

  comment   ReviewerComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  aiSession AiSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("response_suggestions")
}

model AuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
  paperId    String?         @map("paper_id") @db.Uuid
  actionType AuditActionType @map("action_type")
  beforeState Json?          @map("before_state")
  afterState  Json?          @map("after_state")
  ipAddress  String?         @map("ip_address")
  createdAt  DateTime        @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  paper Paper? @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([paperId])
  @@index([userId])
  @@map("audit_logs")
}
